    <string name="section_automation">Automation (Tasker, Automate, adb)</string>
    <!-- The double hyphens are adb command-line flags, not prose dashes. -->
    <string name="automation_help" tools:ignore="TypographyDashes">Send a broadcast to com.personal.dynamicpill/.AutomationReceiver with action com.personal.dynamicpill.action.SHOW and extras: token, title, text, seconds, expand, timer_seconds, live, id. End a live one with action com.personal.dynamicpill.action.END and the same id.\n\nToken: %1$s\n\nExample:\nadb shell am broadcast -n com.personal.dynamicpill/.AutomationReceiver -a com.personal.dynamicpill.action.SHOW --es token %1$s --es title Hello --es text "From automation" --ei seconds 5</string>
